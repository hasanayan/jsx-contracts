{
  "name": "@jsx-contracts/authoring",
  "version": "0.0.14",
  "type": "module",
  "license": "MIT",
  "description": "Type-safe authoring API for JSX composition contracts — defineContracts and the schema-shaped contract() surface that compiles to the rule table the @jsx-contracts/eslint-plugin rules consume.",
  "keywords": [
    "jsx",
    "react",
    "composition",
    "contracts",
    "slots",
    "design-system",
    "eslint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanayan/jsx-contracts.git",
    "directory": "packages/authoring"
  },
  "homepage": "https://github.com/hasanayan/jsx-contracts#readme",
  "bugs": "https://github.com/hasanayan/jsx-contracts/issues",
  "exports": {
    ".": "./build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.js.map",
    "build/**/*.d.ts",
    "build/**/*.d.ts.map"
  ],
  "sideEffects": false,
  "dependencies": {
    "@jsx-contracts/core": "workspace:*"
  },
  "devDependencies": {
    "@jsx-contracts/eslint-plugin": "workspace:*",
    "eslint": "9.39.4",
    "vitest": "4.1.9"
  }
}

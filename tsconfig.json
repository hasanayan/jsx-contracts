{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "eslint.config.ts",
    "knip.config.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    ".sandcastle/**/*.ts"
  ],
  "exclude": [".sandcastle/worktrees/**/*"],
  "references": [
    { "path": "packages/bench" },
    { "path": "packages/core" },
    { "path": "packages/eslint-plugin" },
    { "path": "packages/authoring" },
    { "path": "packages/playground" }
  ]
}
